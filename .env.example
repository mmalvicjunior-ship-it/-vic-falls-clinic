# PostgreSQL connection string (Neon, Railway, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/vicfallsclinic
# 32+ random chars, used to sign sessions. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: used only by scripts/bootstrap-admin.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Clinic Administrator
